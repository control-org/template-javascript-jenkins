{
  "name": "template-javascript-jenkins",
  "version": "1.0.0",
  "description": "Jenkins CI template for JavaScript: lint, tests and coverage",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/Greeter.js",
  "scripts": {
    "lint": "npm run lint:real",
    "lint:real": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
